          { "id": "contact", "label": "Contact sales", "successSignals": ["success-message", "thank-you-url"] }
        ]
      },
      "expected": { "interaction": "form_submission", "state": "awaiting_success_evidence", "canConfirm": false }
    },
    {
      "id": "complete-form-intent-produces-draft",
