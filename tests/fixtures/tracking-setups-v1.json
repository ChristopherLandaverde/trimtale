[
  {
    "schemaVersion": 1,
    "id": "setup_navigation",
    "status": "confirmed",
    "intent": {
      "statement": "Track primary navigation clicks",
      "businessOutcome": "Understand which site sections visitors choose"
    },
    "tagActions": [{
      "id": "tag_navigation",
      "name": "GA4 Event - navigation_click",
      "execution": { "type": "template", "templateId": "google.analytics.ga4_event", "fields": [] },
      "destination": { "type": "ga4", "measurementId": "G-TEST123456" },
      "event": {
        "name": "navigation_click",
        "parameters": [
          { "name": "link_text", "requirement": "required", "value": { "type": "built_in_variable", "name": "Click Text" } },
          { "name": "link_url", "requirement": "required", "value": { "type": "built_in_variable", "name": "Click URL" } },
          { "name": "page_location", "requirement": "recommended", "value": { "type": "built_in_variable", "name": "Page URL" } }
        ]
      },
      "firingPolicyIds": ["policy_navigation"]
    }],
    "firingPolicies": [{
      "id": "policy_navigation",
      "source": { "type": "click", "clickMode": "links", "selector": "header a, nav a" },
      "include": [{ "variable": { "type": "built_in_variable", "name": "Click URL" }, "operator": "starts_with", "value": "https://example.test/" }],
      "exclude": [{ "variable": { "type": "built_in_variable", "name": "Click URL" }, "operator": "contains", "value": "/privacy" }],
      "frequency": "once_per_event",
      "consent": { "required": ["analytics_storage"], "whenDenied": "block" }
    }],
    "verification": {
      "positive": [
        { "type": "tag_fired", "tagActionId": "tag_navigation" },
        { "type": "network_request", "destination": "google_analytics_4", "eventName": "navigation_click" }
      ],
      "negative": [{ "type": "page_error", "messagePattern": "Uncaught" }]
    }
  },
  {
    "schemaVersion": 1,
    "id": "setup_lead_form",
