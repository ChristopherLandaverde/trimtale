      "name": "GA4 Event - generate_lead",
      "execution": { "type": "template", "templateId": "google.analytics.ga4_event", "fields": [] },
      "destination": { "type": "ga4", "measurementId": "G-TEST123456" },
      "event": {
        "name": "generate_lead",
        "parameters": [
          { "name": "form_id", "requirement": "required", "value": { "type": "data_layer_variable", "name": "DLV - form_id", "key": "form_id" } },
          { "name": "form_name", "requirement": "recommended", "value": { "type": "data_layer_variable", "name": "DLV - form_name", "key": "form_name" } }
        ]
      },
      "firingPolicyIds": ["policy_lead"]
    }],
    "firingPolicies": [{
      "id": "policy_lead",
      "source": { "type": "custom_data_layer", "eventName": "generate_lead" },
      "include": [{ "variable": { "type": "built_in_variable", "name": "Page Hostname" }, "operator": "equals", "value": "example.test" }],
      "exclude": [],
      "frequency": "once_per_event",
      "consent": { "required": ["analytics_storage"], "whenDenied": "block" }
    }],
    "verification": {
      "positive": [
        { "type": "data_layer_event", "eventName": "generate_lead" },
        { "type": "network_request", "destination": "google_analytics_4", "eventName": "generate_lead" }
      ],
      "negative": [{ "type": "network_request", "destination": "google_analytics_4", "eventName": "generate_lead", "scenario": "validation_error" }]
    }
  },
  {
    "schemaVersion": 1,
