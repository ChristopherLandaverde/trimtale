{
  "name": "gtm-observability",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gtm-observability/core && npm run build --workspace @gtm-observability/api && npm run build --workspace @gtm-observability/fixture-site && npm run build --workspace @gtm-observability/verification-target && npm run build --workspace @gtm-observability/extension",
    "check": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:google": "tsx apps/api/src/google.integration.ts",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run check && npm test && npm run test:e2e",
    "deploy:verification-target": "tsx scripts/deploy-verification-target.ts",
    "dev:api": "npm run dev --workspace @gtm-observability/api",
    "dev:fixture": "npm run dev --workspace @gtm-observability/fixture-site",
    "build:extension": "npm run build --workspace @gtm-observability/extension"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.31",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
