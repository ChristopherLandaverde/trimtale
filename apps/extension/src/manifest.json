{
  "manifest_version": 3,
  "name": "GTM Observability",
  "description": "Generate and verify evidence-backed GTM navigation tracking.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "identity", "scripting", "storage", "webRequest"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:4173/*",
    "https://*.clerk.accounts.dev/*",
    "*://*.google-analytics.com/*",
    "*://analytics.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open GTM Observability orb"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "toggle-assistant": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Toggle the GTM Observability assistant"
    }
  }
}
