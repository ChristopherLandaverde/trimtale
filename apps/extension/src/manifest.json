{
  "manifest_version": 3,
  "name": "GTM Observability",
  "description": "Generate and verify evidence-backed GTM navigation tracking.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "webRequest"],
  "host_permissions": [
    "http://127.0.0.1:18787/*",
    "http://127.0.0.1:14173/*",
    "https://*.vercel.app/*",
    "*://*.google-analytics.com/*",
    "*://analytics.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open GTM Observability"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
